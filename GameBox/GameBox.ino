// ---------------------------------------------------------------------------
//  GameBox — портативная приставка на ESP32-C3 Super Mini
//  Экран: OLED SSD1306 128x64 (I2C), джойстик KY-023, 4 кнопки.
//
//  Структура проекта:
//    GameBox.ino            — этот файл (setup/loop)
//    src/core/              — ядро: дисплей, графика, шрифты, ввод, меню
//    src/games/             — пять игр
//    src/gfx/               — 1-битные изображения (генерируются скриптом)
//
//  Плата: "ESP32C3 Dev Module", Flash 4 MB, скорость 115200.
// ---------------------------------------------------------------------------
#include "src/core/app.h"

App app;

void setup() {
#ifdef GB_SERIAL_DEBUG
  Serial.begin(115200);
  Serial.println("\nGameBox start");
#endif
  app.begin();
}

void loop() {
  app.tick();
  // Небольшая пауза выравнивает частоту кадров и экономит питание.
  delay(2);
}
